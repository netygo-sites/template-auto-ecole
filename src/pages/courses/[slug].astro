---
import Base from '../../layouts/Base.astro';
import Button from '../../components/Button.astro';
import Pixels from '../../components/Pixels.astro';
import TestiCards from '../../components/TestiCards.astro';
import CtaBand from '../../components/CtaBand.astro';
import PhotoStrip from '../../components/PhotoStrip.astro';
import '../../styles/richtext.css';
import { courses } from '../../data/courses';
import { courseDetails, defaultCourseDetail } from '../../data/courseDetails';

export function getStaticPaths() {
  return courses.map((c) => ({ params: { slug: c.slug }, props: { course: c } }));
}
const { course } = Astro.props;
const d = courseDetails[course.slug] ?? defaultCourseDetail;
const steps = [
  { n: '01.', title: 'Sign up for classes', text: 'Choose your course and register online quickly and hassle-free' },
  { n: '02.', title: 'Learn from experts', text: 'Get professional driving lessons with instructors tailored to your pace' },
  { n: '03.', title: 'Practice on the road', text: 'Build your skills with supervised driving practice in real traffic conditions' },
  { n: '04.', title: 'Pass your test', text: 'Prepare thoroughly and ace your driving exam with our full support' },
];
---
<Base title={`${course.title} — GearUp`} description={course.excerpt}>
  <section class="cd-hero">
    <div class="cd-hero-in">
      <div class="cd-hero-t">
        <div class="tag"><i class="ico i-square dot"></i><h6 class="t-h6m">{course.level}</h6></div>
        <div class="cd-hero-h">
          <h1 class="t-h1 center cd-h1">{course.title}</h1>
          <p class="t-lead center cd-lead">{course.excerpt}</p>
        </div>
      </div>
    </div>
    <div class="cd-img cover"><img src={course.image} alt="" style="object-position:50% 30%" /></div>
  </section>

  <section class="cd-body">
    <div class="cd-body-in">
      <article class="rich cd-article">
        <h2>Course overview</h2>
        <p>{d.overview}</p>
        <h3>What’s included</h3>
        <ul>{d.included.map((li) => <li><p>{li}</p></li>)}</ul>
        <h3>Who this course is for</h3>
        <ul>{d.audience.map((li) => <li><p>{li}</p></li>)}</ul>
        <div class="spacer"></div>
        <img src={d.image} alt="" />
        <h3>Duration &amp; schedule<br /><br /></h3>
        <ul>{d.schedule.map((li) => <li><p>{li}</p></li>)}</ul>
        <h3>Resume</h3>
        <p>{d.resume}</p>
      </article>

      <aside class="cd-side">
        <Pixels cell={20} corner="tr" />
        <div class="cd-info">
          <div class="cd-group">
            <div class="cd-row"><h5 class="t-h5">Level</h5><p class="t-body">{course.level}</p></div>
            <div class="cd-line"></div>
            <div class="cd-row"><h5 class="t-h5">Start date</h5><p class="t-body"><time>{d.startDate}</time></p></div>
            <div class="cd-line"></div>
          </div>
          <div class="cd-group">
            <div class="cd-row"><h5 class="t-h5">Duration</h5><p class="t-body">{d.duration}</p></div>
            <div class="cd-line"></div>
            <div class="cd-row"><h5 class="t-h5">Price</h5><p class="t-body">{d.price}</p></div>
            <div class="cd-line"></div>
          </div>
        </div>
        <Button href="/contact-us" label="Book a Course" class="cd-btn" />
      </aside>
    </div>
  </section>

  <section class="cd-steps">
    <div class="cd-steps-in">
      <div class="cd-steps-l">
        <h2 class="t-h2 hpic-title cd-steps-h"><span class="hpic"><img src="/images/EbB9eodnFNdqxCRRNatDbooI0.jpg" alt="" /></span> Learn to drive with confidence, easy steps to your license</h2>
        <Button href="/contact-us" label="Book Your First Lesson" variant="jaune" class="hide-m" />
      </div>
      <div class="cd-steps-r">
        {steps.map((s) => (
          <>
            <div class="cd-step">
              <div class="cd-step-n">{s.n}</div>
              <div class="cd-step-t">
                <h5 class="t-h5 cd-step-h">{s.title}</h5>
                <p class="t-body cd-step-p">{s.text}</p>
              </div>
            </div>
            <div class="cd-step-line"></div>
          </>
        ))}
      </div>
      <Button href="/contact-us" label="Book Your First Lesson" variant="jaune" class="show-m" />
    </div>
  </section>

  <TestiCards />
  <CtaBand title="Take the first step toward driving with confidence and freedom" label="Get Started Now" href="/contact-us" />
  <PhotoStrip />
</Base>

<style>
  .cd-hero { display: flex; flex-direction: column; align-items: center; gap: 80px; padding: 180px 0 130px; background: var(--creme); overflow: clip; }
  .cd-hero-in { display: flex; flex-direction: column; align-items: center; width: 100%; max-width: 1210px; padding: 0 20px; }
  .cd-hero-t { display: flex; flex-direction: column; align-items: center; gap: 20px; max-width: 530px; }
  .tag { display: flex; align-items: center; gap: 10px; }
  .cd-hero-h { display: flex; flex-direction: column; align-items: center; gap: 16px; }
  .cd-h1 { max-width: 600px; }
  .cd-lead { max-width: 420px; color: var(--encre); }
  .cd-img { width: 100%; height: 550px; }

  .cd-body { display: flex; justify-content: center; padding: 0 0 130px; background: var(--creme); overflow: clip; }
  .cd-body-in { display: flex; align-items: flex-start; justify-content: center; gap: 140px; width: 100%; max-width: 1210px; padding: 0 20px; }
  .cd-article { flex: 1 0 0; }
  .cd-side { position: sticky; top: 140px; z-index: 1; display: flex; flex-direction: column; align-items: flex-start; gap: 20px; flex: 1 0 0; max-width: 360px; padding: 40px; background: var(--sable-2); overflow: clip; }
  .cd-info { display: flex; flex-direction: column; align-items: center; gap: 10px; width: 100%; }
  .cd-group { display: flex; flex-direction: column; align-items: center; gap: 20px; width: 100%; }
  .cd-row { display: flex; flex-direction: column; align-items: flex-start; gap: 8px; width: 100%; }
  .cd-line { width: 100%; height: 1px; background: var(--encre-20); }
  .cd-side :global(.cd-btn) { width: 100%; }

  .cd-steps { display: flex; justify-content: center; padding: 130px 0; background: var(--encre); overflow: clip; }
  .cd-steps-in { display: flex; align-items: flex-start; gap: 200px; width: 100%; max-width: 1210px; padding: 0 20px; }
  .cd-steps-l { display: flex; flex-direction: column; align-items: flex-start; justify-content: space-between; align-self: stretch; flex: 1 0 0; }
  .cd-steps-h { max-width: 560px; color: var(--creme); }
  .cd-steps-r { display: flex; flex-direction: column; align-items: center; flex: 1 0 0; gap: 30px; }
  .cd-step { display: flex; align-items: center; gap: 30px; width: 100%; }
  .cd-step-n { flex: none; width: 100px; font: 700 65px/1 var(--display); letter-spacing: -0.01em; color: var(--jaune); }
  .cd-step-t { display: flex; flex-direction: column; align-items: flex-start; gap: 8px; flex: 1 0 0; }
  .cd-step-h { color: var(--creme); }
  .cd-step-p { color: var(--gris); }
  .cd-step-line { width: 100%; height: 1px; background: var(--creme-20); }

  @media (max-width: 1279px) {
    .cd-hero { gap: 60px; padding: 160px 0 100px; }
    .cd-img { height: 400px; }
    .cd-body { padding-bottom: 100px; }
    .cd-body-in { gap: 80px; }
    .cd-side { max-width: 330px; padding: 30px; }
    .cd-steps { padding: 100px 0; }
    .cd-steps-in { gap: 80px; }
  }
  @media (max-width: 991px) {
    .cd-hero { gap: 40px; padding: 120px 0 80px; }
    .cd-hero-t { max-width: none; }
    .cd-img { height: 400px; }
    .cd-body { padding-bottom: 80px; }
    .cd-body-in { flex-direction: column; gap: 40px; }
    .cd-article { flex: none; width: 100%; }
    .cd-side { position: relative; top: 0; flex: none; width: 100%; max-width: none; align-items: center; padding: 24px; }
    .cd-steps { padding: 80px 0; }
    .cd-steps-in { flex-direction: column; gap: 40px; }
    .cd-steps-l { align-self: auto; flex: none; width: 100%; align-items: flex-end; gap: 10px; }
    .cd-steps-h { max-width: none; width: 100%; }
    .cd-steps-r { flex: none; width: 100%; }
    .cd-step { flex-direction: column; align-items: flex-start; gap: 10px; }
  }
</style>
