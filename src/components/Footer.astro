---
import { site, footerColumns } from '../data/site';
---
<footer class="foot">
  <div class="foot-in">
    <div class="foot-top">
      <div class="foot-brand">
        <div class="foot-id">
          <a href="/" class="foot-logo" aria-label="GearUp">
            <img loading="lazy" decoding="async" src="/images/SxJHBaolYkdZQko7YKTz6XkzBY.svg" alt="GearUp" width="192" height="65" />
          </a>
          <p class="t-lead foot-tag">From first lesson to license your journey starts here.</p>
        </div>
        <div class="socials">
          {site.socials.map((s) => (
            <a href={s.href} target="_blank" rel="noopener" class="social" aria-label={s.name}>
              <i class:list={['ico', `i-${s.icon}`]}></i>
            </a>
          ))}
        </div>
      </div>

      <div class="foot-cols">
        {footerColumns.map((c) => (
          <div class="foot-col">
            <h6 class="t-20 foot-h">{c.title}</h6>
            <nav class="foot-nav">
              {c.links.map((l) => <a href={l.href} class="t-nav link-foot">{l.label}</a>)}
            </nav>
          </div>
        ))}
        <div class="foot-col foot-contact">
          <h6 class="t-20 foot-h">Contact Us</h6>
          <nav class="foot-nav">
            <div class="foot-line"><span class="t-nav foot-lbl">Phone:</span><a href={`tel: ${site.phone}`} class="t-nav link-foot">{site.phone}</a></div>
            <div class="foot-line"><span class="t-nav foot-lbl">Email:</span><a href={`mailto: ${site.email}`} class="t-nav link-foot">{site.email}</a></div>
            <a href={site.mapUrl} target="_blank" rel="noopener" class="t-nav link-foot foot-addr">{site.address}</a>
          </nav>
        </div>
      </div>
    </div>

    <div class="foot-bottom">
      <p class="t-small">© GearUp. All Rights Reserved.</p>
      <p class="t-small foot-right">Designed by <a href="https://fourtwelve.co/" target="_blank" rel="noopener" class="link-foot">Fourtwelve</a>.</p>
    </div>
  </div>
</footer>

<style>
  .foot { display: flex; justify-content: center; padding: 80px 0 30px; background: var(--encre); }
  .foot-in { display: flex; flex-direction: column; gap: 60px; width: 100%; max-width: 1210px; padding: 0 20px; }
  .foot-top { display: flex; align-items: flex-start; justify-content: space-between; }
  .foot-brand { display: flex; flex-direction: column; align-items: flex-start; gap: 40px; width: 330px; flex: none; }
  .foot-id { display: flex; flex-direction: column; align-items: flex-start; gap: 16px; }
  .foot-logo { display: block; width: 194px; height: 66px; }
  .foot-logo img { width: 100%; height: 100%; object-fit: contain; }
  .foot-tag { max-width: 220px; color: var(--gris); }
  .socials { display: flex; align-items: center; gap: 16px; }
  .social { display: flex; align-items: center; justify-content: center; width: 40px; height: 40px; border-radius: 3px; background: var(--jaune); color: var(--encre); transition: background-color .4s var(--ease), color .4s var(--ease); }
  .social:hover { background: var(--creme); }
  .social .ico { width: 18px; height: 18px; }

  .foot-cols { display: flex; flex-wrap: wrap; align-items: flex-start; justify-content: space-between; flex: 1 0 0; }
  .foot-col { display: flex; flex-direction: column; align-items: flex-start; gap: 15px; }
  .foot-h { color: var(--blanc); }
  .foot-nav { display: flex; flex-direction: column; align-items: flex-start; gap: 10px; }
  .foot-line { display: flex; align-items: flex-start; gap: 2px 4px; }
  .foot-lbl { color: var(--gris); }
  .foot-addr { max-width: 190px; white-space: pre-wrap; }
  .foot-bottom { display: flex; align-items: center; gap: 10px; }
  .foot-bottom p { flex: 1 0 0; }
  .foot-right { text-align: right; }

  @media (max-width: 1279px) {
    .foot-brand { width: 270px; }
    .foot-logo { width: 170px; height: 58px; }
    .foot-col { max-width: 130px; }
    .foot-col.foot-contact { max-width: 190px; }
  }
  @media (max-width: 991px) {
    .foot-top { flex-wrap: wrap; justify-content: flex-start; gap: 40px 30px; }
    .foot-brand { flex-direction: row; flex-wrap: wrap; align-items: flex-end; gap: 20px 40px; width: 100%; }
    .foot-id { flex: 1 0 0; }
    .foot-logo { width: 194px; height: 66px; }
    .foot-tag { max-width: 260px; }
    .foot-cols { justify-content: flex-start; gap: 30px 60px; width: 100%; }
    .foot-col { max-width: none; }
    .foot-bottom { flex-direction: column; align-items: flex-start; }
    .foot-bottom p { flex: none; width: 100%; }
    .foot-right { text-align: left; }
  }
</style>
