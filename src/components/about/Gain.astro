---
import IconRow from '../IconRow.astro';
import Button from '../Button.astro';
import Pixels from '../Pixels.astro';
// ordre ligne par ligne de la grille 2 × 2 (colonne 1 : 01 / 03 — colonne 2 : 02 / 04)
const items = [
  { n: '01', title: 'Personalized learning', image: '/images/T6ELpDi8eLTTUAaqPznTjabzNA.jpg' },
  { n: '02', title: 'Real-world practice', image: '/images/8yjhGQXkTFMBg5HKe5S8XXwnHeI.jpg' },
  { n: '03', title: 'State-of-the-art vehicles', image: '/images/iKLGSCLfa5Tyz0sKoSc1hDPQAGs.jpg' },
  { n: '04', title: 'Exam preparation', image: '/images/tLUQkKhOiZMfzQe7vR1MgchxJM.jpg' },
];
---
<section class="gain">
  <div class="gain-in">
    <div class="gain-head">
      <IconRow icons={['gear', 'seat', 'wheel', 'car', 'pump', 'plug', 'sun']} />
      <h2 class="t-h2 center">What you’ll gain from our driving school</h2>
    </div>
    <div class="gain-row">
      <div class="gain-grid">
        {items.map((it) => (
          <div class="gcard">
            <div class="gcard-t">
              <h5 class="t-h5 gcard-h">{it.title}</h5>
              <h6 class="t-h6m gcard-n">{it.n}</h6>
            </div>
            <div class="gcard-img cover"><img loading="lazy" decoding="async" src={it.image} alt="" /></div>
          </div>
        ))}
      </div>
      <div class="gain-dark">
        <h5 class="t-h5 gain-dark-h">Embark on your path to becoming a skilled and confident driver</h5>
        <div class="gain-dark-b">
          <div class="gain-dark-line"></div>
          <p class="t-body gain-dark-p">Whether you're a complete beginner or just need a few refresher lessons, we'll guide you with a clear, supportive approach carefully tailored to your pace</p>
          <Button href="/contact-us" label="Start Learning Today" variant="jaune" />
        </div>
        <Pixels cell={20} corner="br" />
      </div>
    </div>
  </div>
</section>

<style>
  .gain { display: flex; justify-content: center; padding: 130px 0; background: var(--creme); overflow: clip; }
  .gain-in { display: flex; flex-direction: column; align-items: center; gap: 60px; width: 100%; max-width: 1210px; padding: 0 20px; }
  .gain-head { display: flex; flex-direction: column; align-items: center; gap: 40px; max-width: 550px; }
  .gain-row { display: flex; align-items: center; gap: 20px; width: 100%; }
  .gain-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 20px; flex: 1 0 0; }
  .gcard { display: flex; align-items: center; justify-content: space-between; padding: 20px; border-radius: 5px; background: var(--sable-2); }
  .gcard-t { display: flex; flex-direction: column; align-items: flex-start; justify-content: space-between; flex: 1 0 0; max-width: 150px; height: 140px; }
  .gcard-n { order: 1; }
  .gcard-img { flex: none; width: 150px; height: 140px; border-radius: 3px; }
  .gain-dark { position: relative; display: flex; flex-direction: column; align-items: flex-start; gap: 45px; flex: 1 0 0; max-width: 31%; padding: 30px; border-radius: 5px; background: var(--encre); overflow: clip; }
  .gain-dark-h { max-width: 250px; color: var(--creme); }
  .gain-dark-b { display: flex; flex-direction: column; align-items: flex-start; gap: 24px; width: 100%; }
  .gain-dark-line { width: 100%; height: 1px; background: var(--creme-20); }
  .gain-dark-p { color: var(--gris); }

  @media (max-width: 1279px) {
    .gain { padding: 100px 0; }
    .gain-in { gap: 50px; }
    .gain-head { max-width: 500px; }
    .gain-row { gap: 10px; }
    .gain-grid { gap: 10px; }
    .gcard { justify-content: flex-start; gap: 20px; }
    .gcard-img { width: 120px; }
    .gain-dark { gap: 19px; max-width: 32%; }
    .gain-dark-b { gap: 20px; }
  }
  @media (max-width: 991px) {
    .gain { padding: 80px 0; }
    .gain-in { gap: 40px; }
    .gain-head { gap: 30px; max-width: 420px; }
    .gain-row { flex-direction: column; gap: 10px; }
    .gain-grid { grid-template-columns: 1fr; width: 100%; flex: none; }
    .gcard { flex-direction: column; align-items: stretch; gap: 20px; }
    .gcard-t { flex-direction: column-reverse; justify-content: flex-end; gap: 12px; max-width: none; height: auto; }
    .gcard-n { order: 0; }
    .gcard-img { width: 100%; }
    .gain-dark { justify-content: center; gap: 20px; flex: none; width: 100%; max-width: none; padding: 30px 20px; }
    .gain-dark-h { max-width: 330px; }
    .gain-dark-p { max-width: 400px; }
  }
</style>
