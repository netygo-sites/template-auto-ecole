---
import Mosaic from '../Mosaic.astro';
---
<section class="ahero">
  <Mosaic side="left" />
  <Mosaic side="right" />
  <div class="ahero-in">
    <div class="ahero-t">
      <div class="tag"><i class="ico i-square dot"></i><h6 class="t-h6m">About Us</h6></div>
      <div class="ahero-h">
        <h1 class="t-h1 center ahero-h1">Who we are and what drives us</h1>
        <p class="t-lead center">We're passionate instructors, committed to helping every student gain confidence and independence</p>
      </div>
    </div>
  </div>
</section>

<style>
  .ahero { position: relative; display: flex; justify-content: center; padding: 180px 0 130px; background: var(--creme); overflow: clip; }
  .ahero-in { display: flex; justify-content: center; width: 100%; max-width: 1210px; padding: 0 20px; }
  .ahero-t { display: flex; flex-direction: column; align-items: center; gap: 20px; flex: 1 0 0; max-width: 530px; }
  .tag { display: flex; align-items: center; gap: 10px; }
  .ahero-h { display: flex; flex-direction: column; align-items: center; gap: 16px; }
  @media (max-width: 1279px) {
    .ahero { padding: 160px 0 100px; }
    .ahero-t { max-width: 490px; }
    .ahero-h1 { max-width: 470px; }
  }
  @media (max-width: 991px) {
    .ahero { padding: 160px 0 80px; }
    .ahero-t { max-width: none; }
    .ahero-h1 { max-width: 450px; }
  }
</style>
