---
import Button from './Button.astro';
import { services } from '../data/services';
---
<section class="extras">
  <div class="extras-in">
    <div class="extras-head">
      <h2 class="t-h2 extras-h hpic-title">Helpful extras to smooth your road ahead <span class="hpic"><img src="/images/7xYkEcLHhKbpUGHVmYKX7TOVlTw.jpg" alt="" /></span></h2>
      <Button href="/services" label="View All Services" variant="creme" class="hide-m" />
    </div>
    <div class="extras-row">
      {services.slice(0, 4).map((s) => (
        <a href={`/services/${s.slug}`} class="scard">
          <span class="scard-tile"><img src={s.icon} alt="" width="24" height="24" /></span>
          <span class="scard-t">
            <span class="roll t-h5 scard-h"><h5>{s.title}</h5><h5 aria-hidden="true">{s.title}</h5></span>
            <p class="t-body scard-p">{s.excerpt}</p>
          </span>
        </a>
      ))}
    </div>
    <Button href="/services" label="View All Services" variant="creme" class="show-m" />
  </div>
</section>

<style>
  .extras { display: flex; justify-content: center; padding: 130px 0; background: var(--encre); overflow: clip; }
  .extras-in { display: flex; flex-direction: column; align-items: flex-start; gap: 60px; width: 100%; max-width: 1210px; padding: 0 20px; }
  .extras-head { display: flex; align-items: flex-end; justify-content: space-between; width: 100%; }
  .extras-h { flex: 1 0 0; max-width: 560px; color: var(--creme); }
  .extras-row { display: flex; align-items: flex-start; gap: 40px; width: 100%; }
  .scard { display: flex; flex-direction: column; align-items: flex-start; gap: 32px; flex: 1 0 0; }
  .scard-tile { display: flex; align-items: center; justify-content: center; width: 40px; height: 40px; border-radius: 4px; background: var(--jaune); box-shadow: 0 2px 4px 0 var(--encre-10); }
  .scard-tile img { width: 24px; height: 24px; }
  .scard-t { display: flex; flex-direction: column; align-items: flex-start; gap: 10px; width: 100%; }
  .scard-h { width: 100%; color: var(--creme); }
  .scard-p { color: var(--gris); }

  @media (max-width: 1279px) {
    .extras { padding: 100px 0; }
    .extras-in { gap: 50px; }
    .extras-row { gap: 20px; }
  }
  @media (max-width: 991px) {
    .extras { padding: 80px 0; }
    .extras-in { gap: 40px; }
    .extras-h { max-width: none; }
    .extras-row { flex-wrap: wrap; gap: 30px 60px; }
    .scard { flex: 0 0 100%; }
    .scard-p { max-width: 280px; }
  }
</style>
