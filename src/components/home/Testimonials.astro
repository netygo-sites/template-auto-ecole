---
import ArrowButton from '../ArrowButton.astro';
import Pixels from '../Pixels.astro';
const slides = [
  {
    quote: '"I had always been anxious about learning to drive, but from the very first lesson, my instructor made me feel safe, heard, and completely supported. I passed my test with confidence and now actually love driving daily!"',
    author: '— Emily R., 43',
    image: '/images/k5VOdEDPULOkyml2pItgwybkX0.jpg',
    position: '100% 50%',
  },
  {
    quote: '"My instructor explained everything clearly, gave great and detailed feedback, and made sure I fully understood how to handle real traffic, not just empty parking lots. The training was far better than I ever expected."',
    author: '— Daniel K., 29',
    image: '/images/0Pc81cXlvdXS8ngbNG1m5OuJQ.jpg',
    position: '50% 50%',
  },
  {
    quote: '“This school gave me the confidence I needed after years of putting off my license. The instructors were friendly, patient, and knowledgeable. I passed my road test and finally feel independent behind the wheel.”',
    author: '— Sarah M., 35',
    image: '/images/OJBh3qFoWTd23QTIbh5iWbFsUCk.jpg',
    position: '50% 50%',
  },
];
---
<section class="testi" data-slider>
  <div class="testi-in">
    <div class="testi-l">
      <div class="testi-tag">
        <i class="ico i-square dot"></i>
        <h6 class="t-h6m testi-tag-t">Testimonials</h6>
      </div>
      <div class="testi-quote">
        <div class="testi-q">
          <div class="t-big testi-text" data-quote>{slides[0].quote}</div>
          <div class="t-quote testi-author" data-author>{slides[0].author}</div>
        </div>
      </div>
      <div class="testi-arrows">
        <ArrowButton as="button" variant="jaune" icon="chevron" label="Previous testimonial" class="prev" />
        <ArrowButton as="button" variant="jaune" icon="chevron" flip label="Next testimonial" class="next" />
      </div>
    </div>
    <div class="testi-img">
      {slides.map((s, i) => (
        <div class:list={['testi-pic cover', { on: i === 0 }]} data-pic><img loading="lazy" decoding="async" src={s.image} alt="" style={`object-position:${s.position}`} /></div>
      ))}
      <Pixels cell={40} mobileCell={20} corner="br" color="var(--encre)" />
    </div>
  </div>
  <script type="application/json" data-slides set:html={JSON.stringify(slides.map(({ quote, author }) => ({ quote, author })))} />
</section>

<script>
  document.querySelectorAll<HTMLElement>('[data-slider]').forEach((root) => {
    const slides = JSON.parse(root.querySelector('[data-slides]')!.textContent!) as { quote: string; author: string }[];
    const q = root.querySelector<HTMLElement>('[data-quote]')!;
    const a = root.querySelector<HTMLElement>('[data-author]')!;
    const pics = root.querySelectorAll<HTMLElement>('[data-pic]');
    let i = 0;
    const show = (n: number) => {
      i = (n + slides.length) % slides.length;
      q.textContent = slides[i].quote;
      a.textContent = slides[i].author;
      pics.forEach((p, k) => p.classList.toggle('on', k === i));
    };
    root.querySelector('.prev')!.addEventListener('click', () => show(i - 1));
    root.querySelector('.next')!.addEventListener('click', () => show(i + 1));
  });
</script>

<style>
  .testi { display: flex; justify-content: center; padding: 130px 0; background: var(--encre); overflow: clip; }
  .testi-in { display: flex; align-items: center; gap: 80px; width: 100%; max-width: 1210px; padding: 0 20px; }
  .testi-l { display: flex; flex-direction: column; justify-content: center; align-items: flex-start; align-self: stretch; gap: 80px; flex: 1 0 0; }
  .testi-tag { position: relative; z-index: 1; display: flex; align-items: center; gap: 10px; }
  .testi-tag-t { color: var(--creme); }
  .testi-quote { display: flex; align-items: center; width: 100%; }
  .testi-q { display: flex; flex-direction: column; justify-content: center; align-items: center; gap: 32px; flex: 1 0 0; max-width: 510px; }
  .testi-text { width: 100%; color: var(--creme); white-space: pre-wrap; }
  .testi-author { width: 100%; color: var(--creme); }
  .testi-arrows { position: relative; z-index: 1; display: flex; align-items: center; gap: 10px; }
  .testi-img { position: relative; flex: 1 0 0; height: 550px; border-radius: 5px; overflow: clip; }
  .testi-pic { position: absolute; inset: 0; opacity: 0; transition: opacity .6s var(--ease); }
  .testi-pic.on { opacity: 1; }

  @media (max-width: 1279px) {
    .testi { padding: 100px 0; }
    .testi-l { gap: 60px; }
    .testi-q { max-width: 440px; }
  }
  @media (max-width: 991px) {
    .testi { padding: 80px 0; }
    .testi-in { flex-direction: column; gap: 40px; }
    .testi-l { display: contents; }
    .testi-tag { order: 1; width: 100%; }
    .testi-img { order: 2; flex: none; width: 100%; height: 350px; }
    .testi-quote { order: 3; }
    .testi-arrows { order: 4; width: 100%; }
    .testi-q { max-width: none; }
  }
</style>
