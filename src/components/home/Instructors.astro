---
import Button from '../Button.astro';
import InstructorCard from '../InstructorCard.astro';
import { instructors } from '../../data/instructors';
interface Props { noTop?: boolean; }
const { noTop = false } = Astro.props;
---
<section class:list={['instr', { 'no-top': noTop }]}>
  <div class="instr-in">
    <div class="instr-head">
      <div class="instr-head-t">
        <h2 class="t-h2 instr-h">Instructors who make you feel safe on the road</h2>
        <p class="t-lead instr-p">Each member of our team brings a calm presence, deep knowledge, and a passion for helping students</p>
      </div>
      <Button href="/instructors" label="All Instructors" variant="jaune" class="hide-m" />
    </div>
    <div class="icards">
      {instructors.slice(0, 3).map((i, n) => <InstructorCard instructor={i} class={n === 2 ? 'hide-m' : undefined} />)}
    </div>
    <Button href="/instructors" label="All Instructors" variant="jaune" class="show-m" />
  </div>
</section>

<style>
  .instr { display: flex; justify-content: center; padding: 130px 0; background: var(--creme); overflow: clip; }
  .instr.no-top { padding-top: 0; }
  .instr-in { display: flex; flex-direction: column; align-items: flex-start; gap: 60px; width: 100%; max-width: 1210px; padding: 0 20px; }
  .instr-head { display: flex; align-items: flex-end; gap: 40px; width: 100%; }
  .instr-head-t { display: flex; flex-direction: column; align-items: flex-start; gap: 12px; flex: 1 0 0; }
  .instr-h { max-width: 500px; }
  .instr-p { max-width: 470px; }
  .icards { display: flex; align-items: flex-start; gap: 40px; width: 100%; }

  @media (max-width: 1279px) {
    .instr { padding: 100px 0; }
    .instr-in { gap: 50px; }
    .icards { gap: 20px; }
  }
  @media (max-width: 991px) {
    .instr { padding: 80px 0; }
    .instr-in { gap: 40px; }
    .instr-h { max-width: 480px; }
    .icards { flex-wrap: wrap; gap: 40px 20px; }
    .icards :global(.icard) { flex: 0 0 100%; }
  }
</style>
