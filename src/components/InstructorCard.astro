---
import ArrowButton from './ArrowButton.astro';
import type { Instructor } from '../data/instructors';
interface Props { instructor: Instructor; class?: string; }
const { instructor: i, class: className } = Astro.props;
---
<a href={`/instructors/${i.slug}`} class:list={['icard', className]}>
  <div class="icard-img cover"><img loading="lazy" decoding="async" src={i.image} alt={i.name} /></div>
  <div class="icard-row">
    <div class="icard-t">
      <div class="roll t-h5 icard-name"><h5>{i.name}</h5><h5 aria-hidden="true">{i.name}</h5></div>
      <p class="t-body">{i.role}</p>
    </div>
    <ArrowButton />
  </div>
  <div class="icard-line"></div>
</a>

<style>
  .icard { display: flex; flex-direction: column; align-items: center; gap: 20px; flex: 1 0 0; }
  .icard-img { width: 100%; height: 320px; border-radius: 5px; }
  .icard-row { display: flex; align-items: center; gap: 10px; width: 100%; }
  .icard-t { display: flex; flex-direction: column; align-items: flex-start; gap: 8px; flex: 1 0 0; }
  .icard-name { width: 100%; }
  .icard-line { width: 100%; height: 1px; background: var(--encre-20); }
</style>
